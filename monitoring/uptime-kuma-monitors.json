{
  "monitors": [
    {
      "name": "Bastiyah Web Frontend",
      "type": "http",
      "url": "https://bastiyah.com/healthz",
      "interval": 60,
      "retryInterval": 20,
      "maxretries": 3,
      "accepted_statuscodes": ["200-299"],
      "notificationIDList": []
    },
    {
      "name": "Bastiyah Store Subdomains (*.bastiyah.com)",
      "type": "http",
      "url": "https://demo.bastiyah.com/healthz",
      "interval": 60,
      "retryInterval": 20,
      "maxretries": 3,
      "accepted_statuscodes": ["200-299"]
    },
    {
      "name": "Convex Backend Real-Time Cloud",
      "type": "http",
      "url": "https://humorous-wren-70.convex.cloud/api/version",
      "interval": 120,
      "retryInterval": 30,
      "maxretries": 3,
      "accepted_statuscodes": ["200-299", "404"]
    },
    {
      "name": "Traefik Gateway Ping",
      "type": "http",
      "url": "http://traefik:8080/ping",
      "interval": 30,
      "retryInterval": 10,
      "maxretries": 2,
      "accepted_statuscodes": ["200"]
    }
  ]
}
