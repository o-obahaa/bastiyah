# ==========================================
# 🚀 BASTIYAH (بسطية) PLATFORM CONFIGURATION
# ==========================================

# 1. CONVEX DATABASE (Real-time Reactive Multi-Tenant DB)
# Obtain from your Convex Dashboard (https://dashboard.convex.dev) or by running: npx convex dev
VITE_CONVEX_URL=https://<your-project>.convex.cloud

# 2. CLOUDFLARE R2 PICTURE HOSTING (Zero-Egress Object Storage CDN)
# Custom domain connected to your R2 bucket (e.g. images.bastiyah.com) or default R2 dev URL (https://pub-xxx.r2.dev)
VITE_R2_PUBLIC_URL=https://images.bastiyah.com

# Cloudflare R2 S3 Credentials (Configure in Convex Dashboard > Environment Variables)
# Account ID: Found on Cloudflare Dashboard right sidebar (e.g. 7a8b9c...)
CLOUDFLARE_R2_ACCOUNT_ID=
# API Access Key ID: Generated via R2 > Manage R2 API Tokens
CLOUDFLARE_R2_ACCESS_KEY_ID=
# API Secret Access Key:
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Bucket Name:
CLOUDFLARE_R2_BUCKET=bastiyah-images
# Public image CDN base URL:
CLOUDFLARE_R2_PUBLIC_URL=https://images.bastiyah.com

# Optional: Cloudflare Worker upload endpoint if proxying uploads
# VITE_R2_UPLOAD_ENDPOINT=https://upload.bastiyah.com
